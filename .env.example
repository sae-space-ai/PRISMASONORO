# ═══════════════════════════════════════════════════════════════
# PRISMA SONORO — Variables de Entorno
# ═══════════════════════════════════════════════════════════════
# Copia este archivo a .env y configura los valores reales
# cp .env.example .env
#
# IMPORTANTE: Las variables con prefijo VITE_ se exponen al navegador.
# Los secretos deben mantenerse exclusivamente en el servidor.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Configuración de la Aplicación
# ───────────────────────────────────────────────────────────────

# Entorno de ejecución (development | preview | production)
VITE_APP_ENV=development

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# URL base de la aplicación
VITE_APP_URL=http://localhost:5173

# ───────────────────────────────────────────────────────────────
# APIs Externas (Opcional)
# ───────────────────────────────────────────────────────────────

# OpenAI API Key (para asistente IA)
# ⚠️ NO exponer en producción al navegador
# Usar funciones serverless de Vercel para llamadas seguras
VITE_OPENAI_API_KEY=sk-your-key-here

# Modelo de OpenAI a utilizar
VITE_OPENAI_MODEL=gpt-4

# ───────────────────────────────────────────────────────────────
# Almacenamiento (Opcional)
# ───────────────────────────────────────────────────────────────

# Supabase (para persistencia de proyectos)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ───────────────────────────────────────────────────────────────
# Modelos de ML (Opcional)
# ───────────────────────────────────────────────────────────────

# URL del servicio de inferencia (si se usa servidor separado)
VITE_INFERENCE_SERVICE_URL=http://localhost:8000

# Habilitar modelos locales
VITE_ENABLE_LOCAL_MODELS=true

# ───────────────────────────────────────────────────────────────
# Características Experimentales
# ───────────────────────────────────────────────────────────────

# Habilitar capacidades experimentales por defecto
VITE_ENABLE_EXPERIMENTAL=false

# Habilitar telemetría (solo métricas anónimas)
VITE_ENABLE_TELEMETRY=false

# ───────────────────────────────────────────────────────────────
# Configuración de Rendimiento
# ───────────────────────────────────────────────────────────────

# Tamaño máximo de caché en MB
VITE_CACHE_MAX_SIZE_MB=100

# Número máximo de tareas concurrentes
VITE_MAX_CONCURRENT_TASKS=2

# Timeout de operaciones en milisegundos
VITE_OPERATION_TIMEOUT_MS=30000

# ───────────────────────────────────────────────────────────────
# Configuración de Audio
# ───────────────────────────────────────────────────────────────

# Sample rate por defecto
VITE_DEFAULT_SAMPLE_RATE=44100

# Tamaño de buffer para procesamiento
VITE_AUDIO_BUFFER_SIZE=2048

# ───────────────────────────────────────────────────────────────
# Configuración de Depuración
# ───────────────────────────────────────────────────────────────

# Habilitar logs de depuración
VITE_DEBUG=false

# Habilitar React DevTools en producción
VITE_ENABLE_REACT_DEVTOOLS=false

# Mostrar indicadores de rendimiento
VITE_SHOW_PERFORMANCE=false

# ═══════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES
# ═══════════════════════════════════════════════════════════════
#
# 1. NUNCA commitees el archivo .env real al repositorio
# 2. Las variables VITE_* se exponen al navegador
# 3. Los secretos deben ir en funciones serverless de Vercel
# 4. Configura variables diferentes para cada entorno en Vercel
# 5. Las vistas previas NO deben ejecutar entrenamientos reales
#
# ═══════════════════════════════════════════════════════════════
